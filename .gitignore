# Local secrets / overrides
.env

# Runtime state: datasets, outputs, job db, HF model cache (can be huge)
/data/

# Aitrepreneur's paid Patreon content — never distribute. Keep local copies
# here (see docs/reference/README.md), but only README.md is tracked.
docs/reference/*
!docs/reference/README.md

# Private workflows for every ComfyUI app; keep local for UI seeding.
comfyui/apps/*/workflows/
